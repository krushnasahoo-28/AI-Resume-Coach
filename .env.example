# =================================================================
# AI Resume Analyzer & Interview Coach - Environment Configuration
# =================================================================

# Backend API Configuration
PROJECT_NAME="AI Resume Analyzer & Interview Coach"
API_V1_STR="/api"
SECRET_KEY="replace_with_a_secure_random_64_char_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/ai_resume_coach"

# Production CORS Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://your-production-domain.com"

# Optional External AI Service API Keys (Fallback to local NLP engine if omitted)
OPENAI_API_KEY=""

# Frontend Environment Variables (Set in React / Vite environment)
VITE_API_BASE_URL="http://localhost:8000/api"
